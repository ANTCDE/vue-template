{
  "name": "ant-app-vue-template",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "pnpm clear && vite build && pnpm copy && pnpm zip",
    "copy": "pnpm copy-config && pnpm copy-readme && pnpm copy-changelog",
    "copy-config": "pnpm dlx shx cp app-config.json ./dist/app-config.json",
    "copy-readme": "pnpm dlx shx cp README.md ./dist/README.md",
    "copy-changelog": "pnpm dlx shx cp CHANGELOG.md ./dist/CHANGELOG.md",
    "zip": "cd ./dist && pnpm dlx bestzip app.zip *",
    "clear": "pnpm dlx shx rm -rf dist",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@antcde/component-library": "^0.1.17",
    "@antcde/connect-ts": "^0.4.19",
    "@antcde/vue-utils": "^0.2.14",
    "@vueuse/core": "^14.3.0",
    "@vueuse/math": "^14.3.0",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vuetify": "^4.1.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@iconify-json/lucide": "^1.2.115",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/vue": "^5.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@types/node": "^25.9.3",
    "@unocss/preset-rem-to-px": "^66.7.4",
    "@unocss/preset-wind4": "^66.7.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.6.0",
    "happy-dom": "^20.10.6",
    "typescript": "~6.0.3",
    "unocss": "^66.7.4",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.6"
  }
}
